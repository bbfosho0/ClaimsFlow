{
  "name": "claimsflow-shader-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Private local Figma plugin for applying native shaders safely.",
  "bin": {
    "claimsflow-shader": "bin/claimsflow-shader.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
